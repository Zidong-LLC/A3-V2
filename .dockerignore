*.pyc
.pytest_cache
tests/
testsprite_tests/
tools/
docs/
mockups/
output/
capacitacion/
Auditoria Alcance/
data/backups/
data/snapshots/
data/conciliacion-*/
data/evidencias-informe-demostrativo-a3/
data/*.pdf
data/*.html
*.mp4
*.pdf
*.docx
