# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — A3 Laboratorio Veterinario
#
# COPIAR este archivo a `.env` y completar los valores reales.
# El `.env` está en .gitignore: NUNCA se sube al repo.
# Los valores secretos los entrega el responsable del proyecto por un canal
# seguro (gestor de contraseñas / mensaje cifrado), no por chat ni email plano.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_ENV=development            # development | production
APP_TIMEZONE=America/Bogota    # No cambiar: A3 opera en Bogotá
CUTOFF_TIME=17:30              # Hora de corte de recogidas

# Telegram — BotFather (https://t.me/BotFather) → token del bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=       # Cadena aleatoria propia (cualquier secreto largo)
TELEGRAM_WEBHOOK_URL=          # URL pública del webhook (ngrok en local, Render en prod)

# Supabase — Project Settings → API
SUPABASE_URL=                  # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # service_role key (NO la anon). Da acceso total: tratar como secreto
SUPABASE_ACCESS_TOKEN=         # Personal access token (sbp_...) para el MCP de Supabase (.mcp.json). Account → Access Tokens. Read-only recomendado

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini      # Modelo del agente conversacional

# Flask
FLASK_SECRET_KEY=              # Cadena aleatoria propia para firmar sesiones

# Chatwoot — instancia del equipo
CHATWOOT_URL=                  # https://<host>
CHATWOOT_ACCOUNT_ID=           # ID de la cuenta (ej. 2)
CHATWOOT_API_TOKEN=            # Profile Settings → Access Token (agente)
CHATWOOT_AGENT_BOT_TOKEN=      # Token del Agent Bot
CHATWOOT_INBOX_ID=             # ID del inbox de Telegram (ej. 1)
CHATWOOT_TEAM_CONTABILIDAD=    # ID del team de contabilidad
CHATWOOT_TEAM_OPERACIONES=     # ID del team de operaciones

# TestSprite — MCP de testing (https://docs.testsprite.com)
TESTSPRITE_API_KEY=          # API key de TestSprite (Settings → API Keys). La usa el MCP en .mcp.json

# Alegra — facturación electrónica DIAN (https://developer.alegra.com)
# Probar PRIMERO con una cuenta NUEVA de pruebas; al validar, cambiar email/token a la
# del cliente sin tocar código. Credenciales en Alegra → Configuración → API.
ALEGRA_ENABLED=false                                 # false | true (apagado = comportamiento actual)
ALEGRA_EMAIL=                                        # Email de la cuenta Alegra
ALEGRA_API_TOKEN=                                    # API Token (NO la contraseña). Tratar como secreto
ALEGRA_BASE_URL=https://api.alegra.com/api/v1        # No cambiar salvo indicación de Alegra
ALEGRA_PRODUCTION=false                               # false = cuenta de pruebas (acciones de envío/emisión bloqueadas en el dashboard)

# Anarvet — espejo de resultados de exámenes (SOLO lectura, fn_reporte_examenes)
# Credenciales entregadas por Anarvet por canal seguro; el usuario "consulta" solo puede
# ejecutar la función de reporte, sin acceso a tablas. Con el flag apagado nada corre.
ANARVET_ENABLED=false          # false | true (apagado = sin conexión a Anarvet)
ANARVET_DB_HOST=               # IP pública del servidor PostgreSQL de Anarvet
ANARVET_DB_PORT=5432
ANARVET_DB_NAME=VETERINARIA
ANARVET_DB_USER=consulta
ANARVET_DB_PASSWORD=           # Tratar como secreto: solo .env local y env vars de Render
ANARVET_SSLMODE=prefer         # prefer negocia TLS si el servidor lo ofrece

# Generación del PDF del informe EN EL SERVIDOR (Anarvet Fase 2). Solo hace falta para
# PUBLICAR un informe al portal: verlo e imprimirlo desde el navegador nunca depende de
# esto, así que si falla el personal igual puede trabajar. Se despliega apagado y se
# enciende después de verificar /health, igual que ANARVET_ENABLED.
PDF_ENABLED=false              # false | true
PDF_TIMEOUT_MS=20000           # más de esto y se aborta el render en vez de colgar el request
PDF_CHROME_CHANNEL=chrome      # Windows local: usa el Chrome instalado. En Render: dejar VACÍO
PDF_EXECUTABLE_PATH=           # solo para instalaciones fuera de lo común

# Plataforma interna / Dashboard
PLATFORM_API_TOKEN=            # Token para la API interna (opcional)
DASHBOARD_ADMIN_USER=admin     # Usuario del dashboard (cambiar en producción)
DASHBOARD_ADMIN_PASSWORD=admin123  # Contraseña del dashboard (OBLIGATORIO — cambiar en producción, nunca usar el default)

# Portal Web (staff + clientes veterinarias)
SUPABASE_ANON_KEY=             # anon/public key (Project Settings → API). Solo para el login GoTrue del portal
PORTAL_RESULTS_BUCKET=lab-results  # Bucket privado de Storage con los PDFs de resultados

# Buffer de rafagas de mensajes: segundos de espera a que el cliente termine de escribir
# antes de procesar todos sus mensajes juntos como uno solo (0 = apagado, tope MAX_WAIT).
MESSAGE_DEBOUNCE_SECONDS=5
MESSAGE_DEBOUNCE_MAX_WAIT=20

# FSM en modo BLOQUEO (3.2): repara estados incoherentes ademas de loggearlos.
# Encender solo cuando los logs del observador acumulen evidencia limpia.
FSM_ENFORCE=false

# Secreto del webhook de Chatwoot (tapón #3 de WhatsApp). Chatwoot no firma los webhooks
# de agent bot: el secreto viaja en la URL del webhook (…/chatwoot/webhook?token=ESTE).
# OBLIGATORIO en producción; vacío = modo abierto solo para desarrollo.
CHATWOOT_WEBHOOK_SECRET=
